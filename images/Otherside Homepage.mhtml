"); }

* { margin: 0px; }

a { text-decoration: none; cursor: pointer; }

figure { margin: 0px; }

button { border-width: medium; border-style: none; border-color: currentcol=
or; border-image: initial; cursor: pointer; }

input { border-width: medium; border-style: none; border-color: currentcolo=
r; border-image: initial; }

input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { appear=
ance: none; margin: 0px; }

nav { position: relative; display: flex; justify-content: space-between; ba=
ckground-color: var(--blue); z-index: 3; }

.nav-buttons { display: flex; align-items: center; }

.nav-buttons a, a:visited { color: var(--black); }

.nav-buttons a { display: flex; align-items: center; justify-content: cente=
r; height: 100%; }

.nav-shop { font-family: Jaro; font-size: 150%; margin-right: 40px; }

.nav-about { font-family: Inter; margin-right: 10px; }

.nav-cart { font-family: Poppins; padding: 25px; }

.nav-logo { width: 50%; height: auto; display: flex; justify-content: flex-=
start; margin: 10px; }

.cart-wrapper { position: relative; }

.hover-cart { display: block; position: absolute; top: 69px; right: 0px; wi=
dth: 550px; background-color: var(--pink); color: var(--black); padding: 15=
px; border-radius: 15px 0px 15px 15px; box-shadow: rgba(0, 0, 0, 0.2) -20px=
 20px 20px; z-index: 10; }

.empty-text { text-align: center; font-family: Koulen; font-size: 40px; mar=
gin-top: 10px; }

.close-cart { display: flex; font-family: Notable; font-size: 25px; backgro=
und-color: var(--green); text-align: center; padding: 10px; margin: 0px aut=
o 20px; border-radius: 10px; }

.cart-wrapper:hover .nav-cart { background-color: rgb(244, 205, 212); }

.hover-container { display: flex; margin-right: 0px; background-color: var(=
--white); border-radius: 15px; }

.hover-container-image-one { width: 30%; height: auto; background-color: va=
r(--green); border-radius: 15px 0px; margin-right: 10px; }

.hover-cart-info { display: flex; flex-direction: column; align-items: flex=
-start; margin-right: 30px; }

